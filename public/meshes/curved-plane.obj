# Curved plane: 4×4 grid of quads (5×5 vertex grid) curving toward +Z at the
# X-axis edges, like a slightly bent piece of paper. Used as the canonical
# projection-test mesh for the dev app's projection example.
#
# X ∈ [-0.5, 0.5], Y ∈ [-0.5, 0.5], Z = -0.4 * x²
# UVs map across the full plane: u = (x + 0.5), v = (y + 0.5).

# Vertices (5×5 = 25)
v -0.5 -0.5 -0.10
v -0.25 -0.5 -0.025
v 0.0 -0.5 0.0
v 0.25 -0.5 -0.025
v 0.5 -0.5 -0.10

v -0.5 -0.25 -0.10
v -0.25 -0.25 -0.025
v 0.0 -0.25 0.0
v 0.25 -0.25 -0.025
v 0.5 -0.25 -0.10

v -0.5 0.0 -0.10
v -0.25 0.0 -0.025
v 0.0 0.0 0.0
v 0.25 0.0 -0.025
v 0.5 0.0 -0.10

v -0.5 0.25 -0.10
v -0.25 0.25 -0.025
v 0.0 0.25 0.0
v 0.25 0.25 -0.025
v 0.5 0.25 -0.10

v -0.5 0.5 -0.10
v -0.25 0.5 -0.025
v 0.0 0.5 0.0
v 0.25 0.5 -0.025
v 0.5 0.5 -0.10

# Texture coordinates (5×5 grid; V is in OBJ's bottom-up convention since
# parseObj flips it to 1-V on parse).
vt 0.0 0.0
vt 0.25 0.0
vt 0.5 0.0
vt 0.75 0.0
vt 1.0 0.0

vt 0.0 0.25
vt 0.25 0.25
vt 0.5 0.25
vt 0.75 0.25
vt 1.0 0.25

vt 0.0 0.5
vt 0.25 0.5
vt 0.5 0.5
vt 0.75 0.5
vt 1.0 0.5

vt 0.0 0.75
vt 0.25 0.75
vt 0.5 0.75
vt 0.75 0.75
vt 1.0 0.75

vt 0.0 1.0
vt 0.25 1.0
vt 0.5 1.0
vt 0.75 1.0
vt 1.0 1.0

# Normals — single placeholder (not used by the projection shader).
vn 0.0 0.0 1.0

# Faces — 4×4 quads, fan-triangulated as two triangles each.
# Row 0 (verts 1–10)
f 1/1/1 2/2/1 7/7/1 6/6/1
f 2/2/1 3/3/1 8/8/1 7/7/1
f 3/3/1 4/4/1 9/9/1 8/8/1
f 4/4/1 5/5/1 10/10/1 9/9/1

# Row 1 (verts 6–15)
f 6/6/1 7/7/1 12/12/1 11/11/1
f 7/7/1 8/8/1 13/13/1 12/12/1
f 8/8/1 9/9/1 14/14/1 13/13/1
f 9/9/1 10/10/1 15/15/1 14/14/1

# Row 2 (verts 11–20)
f 11/11/1 12/12/1 17/17/1 16/16/1
f 12/12/1 13/13/1 18/18/1 17/17/1
f 13/13/1 14/14/1 19/19/1 18/18/1
f 14/14/1 15/15/1 20/20/1 19/19/1

# Row 3 (verts 16–25)
f 16/16/1 17/17/1 22/22/1 21/21/1
f 17/17/1 18/18/1 23/23/1 22/22/1
f 18/18/1 19/19/1 24/24/1 23/23/1
f 19/19/1 20/20/1 25/25/1 24/24/1
