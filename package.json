{
  "name": "pimco-renderer-2d",
  "description": "Multi-threaded 2D compositing renderer for product image components",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/PimcoRenderer.js",
  "module": "./dist/PimcoRenderer.js",
  "types": "./dist/PimcoRenderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/PimcoRenderer.d.ts",
      "default": "./dist/PimcoRenderer.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --dir src/js",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:coverage": "vitest run --coverage --dir src/js",
    "lint": "eslint src dev-app --ext .ts,.tsx",
    "lint:fix": "eslint src dev-app --ext .ts,.tsx --fix",
    "format": "prettier --write \"{src,dev-app,tests}/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"{src,dev-app,tests}/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run format && npm run lint && npm run type-check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^7.3.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "webgl-postprocessor": "github:choc-sproc/webgl-postprocessor"
  }
}
